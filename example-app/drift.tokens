// Design Tokens for Example App

colors {
  // Brand colors
  primary.500: #3b82f6
  primary.600: #2563eb
  primary.700: #1d4ed8
  
  // Neutral colors
  gray.50: #f9fafb
  gray.100: #f3f4f6
  gray.200: #e5e7eb
  gray.300: #d1d5db
  gray.400: #9ca3af
  gray.500: #6b7280
  gray.600: #4b5563
  gray.700: #374151
  gray.800: #1f2937
  gray.900: #111827
  
  // Semantic colors
  success: #10b981
  warning: #f59e0b
  error: #ef4444
  
  // Base colors
  white: #ffffff
  black: #000000
}

spacing {
  scale: 1.5
  base: 4px
  // Generates: $space.1 (4px), $space.2 (6px), $space.3 (9px), $space.4 (14px), etc.
}

typography {
  scale: 1.25
  base: 16px
  // Generates: $text.xs, $text.sm, $text.base, $text.lg, $text.xl, $text.2xl, etc.
  
  // Font families (custom)
  family.sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif
  family.mono: "SF Mono", Monaco, "Cascadia Code", "Roboto Mono", Consolas, monospace
  
  // Font weights
  weight.normal: 400
  weight.medium: 500
  weight.semibold: 600
  weight.bold: 700
}

easing {
  smooth: cubic-bezier(0.4, 0, 0.2, 1)
  bounce: cubic-bezier(0.68, -0.55, 0.265, 1.55)
  linear: linear
}

shadows {
  sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05)
  md: 0 4px 6px -1px rgba(0, 0, 0, 0.1)
  lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1)
  xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1)
}

borders {
  radius.sm: 4px
  radius.md: 6px
  radius.lg: 8px
  radius.xl: 12px
  radius.full: 9999px
  
  width.thin: 1px
  width.medium: 2px
  width.thick: 4px
}

fonts {
  heading: google:Inter weights:400,700 subsets:latin
  body:    google:Roboto weights:400,500 subsets:latin
}
