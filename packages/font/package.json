{
  "name": "@drift/font",
  "version": "0.1.0",
  "description": "Font loading and CSS generation for Drift apps",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  },
  "keywords": [
    "drift",
    "font",
    "typography",
    "next-font",
    "web-fonts",
    "react",
    "frontend",
    "framework",
    "compiler",
    "routing",
    "styling",
    "animation",
    "design-tokens",
    "vite"
  ],
  "author": "Drift contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/ciphrnotfound/drift.git",
    "directory": "packages/font"
  },
  "bugs": {
    "url": "https://github.com/ciphrnotfound/drift/issues"
  },
  "homepage": "https://github.com/ciphrnotfound/drift#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
