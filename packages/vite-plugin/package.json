{
  "name": "@drift/vite-plugin",
  "version": "0.1.0",
  "description": "Vite plugin for Drift framework",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest"
  },
  "dependencies": {
    "@drift/types": "workspace:*",
    "@drift/compiler": "workspace:*",
    "@drift/tokens": "workspace:*",
    "@drift/router": "workspace:*"
  },
  "devDependencies": {
    "vite": "^6.4.3"
  },
  "peerDependencies": {
    "vite": "^6.4.3"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ciphrnotfound/drift.git",
    "directory": "packages/vite-plugin"
  },
  "bugs": {
    "url": "https://github.com/ciphrnotfound/drift/issues"
  },
  "homepage": "https://github.com/ciphrnotfound/drift#readme",
  "author": "Drift contributors",
  "keywords": [
    "drift",
    "react",
    "framework",
    "compiler",
    "styling",
    "animation",
    "tokens",
    "design-system",
    "parser",
    "ast",
    "transpiler",
    "cli",
    "command-line",
    "scaffolding",
    "vite",
    "plugin",
    "hmr",
    "frontend",
    "routing",
    "design-tokens"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
