tokens
  colors
    primary: #007bff
    secondary: #6c757d
    success: #28a745
    danger: #dc3545

  spacing
    xs: 4px
    sm: 8px
    md: 16px
    lg: 24px
    xl: 32px

  typography
    xs: 12px
    sm: 14px
    md: 16px
    lg: 20px
    xl: 24px

  easing
    smooth: cubic-bezier(0.4, 0.0, 0.2, 1)
    bounce: cubic-bezier(0.68, -0.55, 0.265, 1.55)
